{
  "name": "tb-tours",
  "version": "1.0.0",
  "description": "TB Tours full-stack app (Angular + Node.js)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm --prefix frontend start",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:prod": "npm --prefix frontend run build:prod",
    "build:staging": "npm --prefix frontend run build:staging"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
